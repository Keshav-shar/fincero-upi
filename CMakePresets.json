{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{FINCERO_BUILD_ROOT}/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-20",
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FINCERO_WERROR": "ON",
        "VCPKG_INSTALLED_DIR": "$env{FINCERO_BUILD_ROOT}/vcpkg_installed"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug build with Clang",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FINCERO_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FINCERO_SANITIZE": "thread"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets with ASan and UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FINCERO_ENABLE_FUZZ": "ON",
        "FINCERO_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "ci",
      "displayName": "Optimised Clang build with clang-tidy",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FINCERO_ENABLE_TIDY": "ON"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "Optimised GCC build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "ci-gcc", "configurePreset": "ci-gcc" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "fuzz", "inherits": "base", "configurePreset": "fuzz" },
    { "name": "ci", "inherits": "base", "configurePreset": "ci" },
    { "name": "ci-gcc", "inherits": "base", "configurePreset": "ci-gcc" }
  ]
}
